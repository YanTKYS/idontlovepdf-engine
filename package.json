{
  "name": "@idontlovepdf/engine",
  "version": "0.3.0",
  "description": "Offline, browser-native engine for replacing text in existing PDF content streams",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/experimental",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\"",
    "pretest:browser": "npm run build && npm run poc:build",
    "test:browser": "node --test \"test/browser/*.test.js\"",
    "check": "for file in src/*.js src/experimental/*.js scripts/*.js web/*.js test/*.js test/browser/*.js; do node --check \"$file\"; done",
    "build": "node scripts/build.js",
    "sync-version": "node scripts/sync-version.js",
    "assess:corpus": "node scripts/assess-corpus.js",
    "poc:font": "node scripts/fetch-poc-font.js",
    "poc:build": "node scripts/build-poc.js"
  },
  "keywords": [
    "pdf",
    "offline",
    "browser",
    "text-editing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "opentype.js": "^1.3.4",
    "playwright": "1.56.0"
  }
}
