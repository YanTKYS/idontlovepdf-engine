{
  "name": "@idontlovepdf/local-text-editor",
  "version": "0.2.0",
  "description": "Offline, browser-native prototype for replacing text in existing PDF content streams",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test",
    "check": "for file in src/*.js scripts/*.js web/*.js test/*.js; do node --check \"$file\"; done",
    "build": "node scripts/build.js",
    "sync-version": "node scripts/sync-version.js",
    "assess:corpus": "node scripts/assess-corpus.js"
  },
  "keywords": [
    "pdf",
    "offline",
    "browser",
    "text-editing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.56.0"
  }
}
